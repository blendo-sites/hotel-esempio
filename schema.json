            "type": "object"
          },
          "ordine": {
            "description": "Posizione nell'elenco: prima i numeri bassi.",
            "maximum": 999,
            "minimum": 0,
            "type": "integer"
          },
          "ospiti": {
            "description": "Numero massimo di ospiti.",
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "prezzo_da": {
            "description": "Prezzo a notte a partire da, in euro.",
            "maximum": 100000,
            "minimum": 0,
            "type": "number"
