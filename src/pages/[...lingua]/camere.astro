---
import { getCollection } from "astro:content";
import T from "../../components/T.astro";
import { parola, percorsiLingue, prezzoInEuro, type Lingua } from "../../i18n/index.ts";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = percorsiLingue;

const { lingua } = Astro.props as { lingua: Lingua };
const camere = (await getCollection("camere")).map((c) => c.data).sort((a, b) => a.ordine - b.ordine);
---

<Base lingua={lingua} pagina="camere" titolo={parola("camere", lingua)}>
  <h1>{parola("camere", lingua)}</h1>
  <ul class="griglia">
    {
      camere.map((camera) => (
        <li class="scheda">
          {camera.foto && <img src={camera.foto} alt="" width="600" height="400" loading="lazy" />}
          <div class="scheda__corpo">
            <h2>
              <T t={camera.nome} lingua={lingua} />
            </h2>
            <p>
              <T t={camera.descrizione} lingua={lingua} />
            </p>
            <p class="dettagli">
              {camera.metri_quadri} m² · {camera.ospiti} {parola("ospiti", lingua)} · {parola("da", lingua)}{" "}
              {prezzoInEuro(camera.prezzo_da, lingua)} {parola("a_notte", lingua)}
            </p>
            {camera.servizi.length > 0 && (
              <ul>
                {camera.servizi.map((s) => (
                  <li>
                    <T t={s} lingua={lingua} />
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Base>
